<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>AgentLauncher</AssemblyName>
    <RootNamespace>Agent</RootNamespace>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <InvariantGlobalization>true</InvariantGlobalization>
    <DebugType>none</DebugType>
    <PlatformTarget>x64</PlatformTarget>
    <TreatWarningsAsErrors>True</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\Agent\Program.cs" Link="Program.cs" />
    <Compile Include="..\Agent\Executer.cs" Link="Executer.cs" />
    <Compile Include="..\Agent\SerialComms.cs" Link="SerialComms.cs" />
    <Compile Include="..\Agent\TransportStream.cs" Link="TransportStream.cs" />
    <Compile Include="..\Agent\TLV\TLVHandling.cs" Link="TLV\TLVHandling.cs" />
    <Compile Include="..\Agent\VNC\VNCServer.cs" Link="VNC\VNCServer.cs" />
    <Compile Include="..\Agent\VNC\VNCFramebufferSource.cs" Link="VNC\VNCFramebufferSource.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging" Version="8.0.1" />
    <PackageReference Include="ScreenCapture.NET.DX11" Version="3.0.0" />
    <PackageReference Include="SerialPortStream" Version="2.4.2" />
    <PackageReference Include="Quamotion.RemoteViewing" Version="1.1.211" />
    <PackageReference Include="WebSocketSharp-netstandard" Version="1.0.1" />
    <PackageReference Include="WmiLight" Version="6.7.0" />
  </ItemGroup>

</Project>